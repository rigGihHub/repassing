# Database is intentionally optional for the v0.2 preview shell.
# Connect managed PostgreSQL before enabling persistent identity/organizations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/repassing"

# Public canonical URL. Vercel can run without this during preview.
NEXT_PUBLIC_APP_URL="https://repassing.se"

# Future managed authentication adapter settings belong here; never commit secrets.
# AUTH_PROVIDER="..."
# AUTH_SECRET="..."
