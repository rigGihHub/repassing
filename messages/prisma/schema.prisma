generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  email                   String?                  @unique
  displayName             String?
  locale                  String                   @default("sv-SE")
  countryCode             String                   @default("SE")
  status                  UserStatus               @default(ACTIVE)
  termsAcceptedAt         DateTime?
  privacyAcceptedAt       DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  identities              IdentityAccount[]
  organizationMemberships OrganizationMembership[]
  teamMemberships         TeamMembership[]
  listings                Listing[]                @relation("ListingSeller")
  buyerOrders             Order[]                  @relation("OrderBuyer")
  sellerOrders            Order[]                  @relation("OrderSeller")
  createdInvites          OrganizationInvite[]     @relation("InviteCreator")
}

model IdentityAccount {
  id              String   @id @default(uuid())
  userId          String
  provider        String
  providerSubject String
  emailAtProvider String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model Organization {
  id              String                   @id @default(uuid())
  parentId        String?
  type            OrganizationType         @default(CLUB)
  status          OrganizationStatus       @default(ACTIVE)
  name            String
  slug            String                   @unique
  countryCode     String                   @default("SE")
  defaultCurrency String                   @default("SEK")
  locale          String                   @default("sv-SE")
  timezone        String                   @default("Europe/Stockholm")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  parent          Organization?            @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Organization[]           @relation("OrganizationHierarchy")
  memberships     OrganizationMembership[]
  invites         OrganizationInvite[]
  teams           Team[]
  listings        Listing[]

  @@index([parentId, type])
  @@index([countryCode, status])
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, status, role])
  @@index([userId, status])
}

model OrganizationInvite {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole @default(MEMBER)
  tokenHash      String           @unique
  status         InviteStatus     @default(PENDING)
  createdById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([email, status])
}

model Team {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  slug           String
  sportKey       String?
  ageGroup       String?
  status         TeamStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    TeamMembership[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model TeamMembership {
  id        String         @id @default(uuid())
  userId    String
  teamId    String
  role      TeamRole       @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId, status, role])
}

model Listing {
  id             String        @id @default(uuid())
  sellerId       String
  organizationId String
  title          String
  description    String?
  categoryKey    String
  sportKey       String?
  sizeLabel      String?
  conditionKey   String?
  priceMinor     Int
  currency       String
  scope          ListingScope  @default(ORGANIZATION)
  status         ListingStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  seller         User          @relation("ListingSeller", fields: [sellerId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])
  images         ListingImage[]
  order          Order?

  @@index([organizationId, status, createdAt])
  @@index([sellerId, status])
}

model ListingImage {
  id         String  @id @default(uuid())
  listingId  String
  storageKey String
  sortOrder  Int     @default(0)
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
}

model Order {
  id            String      @id @default(uuid())
  listingId     String      @unique
  buyerId       String
  sellerId      String
  subtotalMinor Int
  currency      String
  status        OrderStatus @default(PENDING_PAYMENT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  listing       Listing     @relation(fields: [listingId], references: [id])
  buyer         User        @relation("OrderBuyer", fields: [buyerId], references: [id])
  seller        User        @relation("OrderSeller", fields: [sellerId], references: [id])
  payment       Payment?
  fulfillment   Fulfillment?
  fees          Fee[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  provider          String
  providerPaymentId String?       @unique
  amountMinor       Int
  currency          String
  status            PaymentStatus
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Fee {
  id          String  @id @default(uuid())
  orderId     String
  type        FeeType
  amountMinor Int
  currency    String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type])
}

model Fulfillment {
  id           String            @id @default(uuid())
  orderId      String            @unique
  method       FulfillmentMethod
  status       FulfillmentStatus @default(PENDING)
  handoverNote String?
  completedAt  DateTime?
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DELETED
}

enum OrganizationType {
  FEDERATION
  REGION
  CLUB
  SECTION
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationRole {
  MEMBER
  TEAM_ADMIN
  CLUB_ADMIN
  OWNER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TeamRole {
  MEMBER
  TEAM_ADMIN
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum ListingScope {
  TEAM
  ORGANIZATION
  NEARBY
  GLOBAL
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  COMPLETED
  CANCELLED
  REMOVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  READY_FOR_HANDOVER
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FeeType {
  PLATFORM
  BUYER
  SELLER
  ORGANIZATION
  PSP
}

enum FulfillmentMethod {
  TRAINING
  CLUBHOUSE
  MATCH
  PICKUP
  AGREEMENT
  SHIPPING
}

enum FulfillmentStatus {
  PENDING
  READY
  COMPLETED
  CANCELLED
}
